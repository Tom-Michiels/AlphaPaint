[Unit]
Description=AlphaPaint Daemon
After=network.target
Documentation=https://github.com/Tom-Michiels/AlphaPaint

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/AlphaPaint/Software/Daemon
ExecStart=/home/pi/AlphaPaint/Software/Daemon/venv/bin/python /home/pi/AlphaPaint/Software/Daemon/daemon.py /home/pi/AlphaPaint/Software/Daemon/config.yaml
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alphapaint-daemon

[Install]
WantedBy=multi-user.target
